# Euron Open AI Chat App: build-time settings (read by react-native-config).
# Copy to .env. The server is euron-open-ai-chat: run `make up && make demo` there first.
#
# Local stack: the iOS simulator reaches your Mac's localhost directly. For the Android
# emulator or a USB device, run `pnpm android:reverse` so localhost works there too.
# On a physical device over Wi-Fi, use your Mac's LAN address instead of localhost.

# The server the app talks to first, including /api. People can change it on the welcome
# screen unless ALLOW_CUSTOM_SERVER is false.
API_BASE_URL=http://localhost:5036/api
# URL scheme for deep links. Must match ios/OpenChat/Info.plist and
# android/app/src/main/AndroidManifest.xml (scripts/rename-app.sh changes all three).
APP_SCHEME=openchat
# Set to false for a build locked to API_BASE_URL (a company's own app).
ALLOW_CUSTOM_SERVER=true
