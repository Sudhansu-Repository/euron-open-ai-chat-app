{
  "name": "euron-open-ai-chat-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8098",
    "ios": "react-native run-ios --port 8098",
    "start": "react-native start --port 8098",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "pods": "cd ios && bundle exec pod install",
    "sync-types": "node scripts/sync-types.mjs",
    "sync-types:check": "node scripts/sync-types.mjs --check",
    "sanitize": "bash scripts/check-sanitization.sh",
    "e2e:ios": "maestro test --platform ios e2e/flows",
    "e2e:android": "maestro test --platform android e2e/flows",
    "android:reverse": "bash scripts/android-reverse.sh"
  },
  "dependencies": {
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.3",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/messaging": "^27.1.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/query-sync-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react-native": "^1.61.0",
    "marked": "^18.1.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.25.1",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "^2.33.1",
    "react-native-image-picker": "^8.3.0",
    "react-native-inappbrowser-reborn": "^3.7.1",
    "react-native-keyboard-controller": "^1.22.9",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-nitro-sound": "^0.2.20",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.16.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "2.1.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "description": "Euron Open AI Chat App: the iOS and Android client for Euron Open AI Chat",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0"
}
